# Copia este archivo a `.env` y completa los valores reales.
# Si dejas las claves vacías, los microservicios corren en "modo simulación"
# (los adaptadores externos devuelven datos de ejemplo y no fallan).

# --- API de Google Maps (ms-viajes) ---
# Obtenla en https://console.cloud.google.com -> APIs y servicios -> Credenciales
# Habilita "Distance Matrix API".
GOOGLE_MAPS_API_KEY=

# --- OpenAI (ms-pagos, análisis de fraude) ---
# Obtenla en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Telegram Bot (ms-notificaciones) ---
# 1. Habla con @BotFather en Telegram y crea un bot con /newbot
# 2. Copia el token que te da.
TELEGRAM_BOT_TOKEN=

# --- URLs de servicios externos (opcionales, tienen valores por defecto) ---
# GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com
# DOLAR_BASE_URL=https://open.er-api.com
# EXTERNO_DOLAR_BASE_URL=https://open.er-api.com
# OPENAI_BASE_URL=https://api.openai.com
# TELEGRAM_BASE_URL=https://api.telegram.org
